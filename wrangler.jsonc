{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "icare-dashboard",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
